{
  "name": "garmin-pomodoro-timetagger",
  "dockerComposeFile": [
    "docker-compose.yml",
    "docker-compose.override.yml"
  ],
  "service": "pomodoro",
  "workspaceFolder": "/workspace/pomodoro",
  "remoteUser": "node",
  "initializeCommand": "bash .devcontainer/scripts/init-host.sh",
  "postCreateCommand": "bash .devcontainer/scripts/post-create.sh",
  "customizations": {
    "vscode": {
      "extensions": [
        "garmin.monkey-c",
        "vivaxy.vscode-conventional-commits",
        "mhutchie.git-graph",
        "donjayamanne.githistory",
        "eamodio.gitlens",
        "redhat.vscode-xml",
        "jebbs.markdown-extended"
      ]
    }
  }
}
